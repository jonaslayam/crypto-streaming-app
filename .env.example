# Binance API credentials (read-only key is enough; the pipeline never places orders)
BINANCE__API_KEY=
BINANCE__API_SECRET=

# Oracle Autonomous Data Warehouse connection
# ORACLE__DSN is a full TNS connect descriptor (host/port/service_name), not just a hostname.
# See https://github.com/jonaslayam/crypto-streaming-iac for how this instance gets provisioned.
ORACLE__USER=
ORACLE__PASSWORD=
ORACLE__DSN=

# Redpanda/Kafka broker the producer and processor connect to.
# Defaults to redpanda:9092 inside docker-compose, localhost:19092 for a local run.
KAFKA_BROKER=

# Redis host for rate-limit tracking and last-seen-timestamp state.
# Defaults to redis inside docker-compose, localhost outside it.
REDIS_HOST=

# Public IP redpanda advertises for external (non-Docker) clients, e.g. a local
# `python -m backtest` or a DBeaver connection reaching into the container.
BROKER_EXTERNAL_IP=
